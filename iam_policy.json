{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "InvocarModeloBedrock",
      "Effect": "Allow",
      "Action": ["bedrock:InvokeModel"],
      "Resource": "*"
    },
    {
      "Sid": "EnviarEmailSES",
      "Effect": "Allow",
      "Action": ["ses:SendEmail"],
      "Resource": "*"
    },
    {
      "Sid": "MemoriaDoAgenteDynamoDB",
      "Effect": "Allow",
      "Action": ["dynamodb:GetItem", "dynamodb:PutItem"],
      "Resource": "arn:aws:dynamodb:*:*:table/corretor-cosmico-memoria"
    }
  ]
}
